
# MAIN MATRIX REINFORCEMENT LEARNING PROJECT

# IMPORTING REQUIRED LIBRARIES


import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

import torch
import torch.nn as nn
import torch.optim as optim

from torch.utils.data import DataLoader
from torch.utils.data import TensorDataset

# CHECKING GPU AVAILABILITY

device = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

print("Using Device :", device)

# RANDOM SEED FOR REPRODUCIBILITY

torch.manual_seed(42)
np.random.seed(42)

# DEFINING STATE SPACE AND ACTION SPACE

state_size = 32

action_size = 6

# CREATING MATRIX DATASET

# Creating random matrix input dataset

matrix_data = np.random.rand(5000, state_size)

# Creating random labels/actions

labels = np.random.randint(
    0,
    action_size,
    size=(5000,)
)

# CONVERTING DATA INTO TENSORS

X_tensor = torch.FloatTensor(matrix_data)

y_tensor = torch.LongTensor(labels)

# CREATING DATALOADER


dataset = TensorDataset(X_tensor, y_tensor)

data_loader = DataLoader(
    dataset,
    batch_size=64,
    shuffle=True
)

# DEFINING REWARD FUNCTION

def reward_function(predicted_action, true_action):

    # Positive reward for correct action
    if predicted_action == true_action:
        return 1.0

    # Small penalty for incorrect action
    else:
        return -0.5

# POLICY NETWORK

class PolicyNetwork(nn.Module):

    def __init__(self):

        super(PolicyNetwork, self).__init__()

        self.network = nn.Sequential(

            nn.Linear(state_size, 256),
            nn.ReLU(),

            nn.Linear(256, 128),
            nn.ReLU(),

            nn.Linear(128, 64),
            nn.ReLU(),

            nn.Linear(64, action_size),

            nn.Softmax(dim=-1)
        )

    def forward(self, x):

        return self.network(x)

# VALUE NETWORK

class ValueNetwork(nn.Module):

    def __init__(self):

        super(ValueNetwork, self).__init__()

        self.network = nn.Sequential(

            nn.Linear(state_size, 256),
            nn.ReLU(),

            nn.Linear(256, 128),
            nn.ReLU(),

            nn.Linear(128, 1)
        )

    def forward(self, x):

        return self.network(x)

# INITIALIZING MODELS


policy_model = PolicyNetwork().to(device)

value_model = ValueNetwork().to(device)

# OPTIMIZERS

policy_optimizer = optim.Adam(
    policy_model.parameters(),
    lr=0.001
)

value_optimizer = optim.Adam(
    value_model.parameters(),
    lr=0.001
)

# TRAINING PARAMETERS

epochs = 50

policy_loss_history = []

value_loss_history = []

reward_history = []

# TRAINING LOOP

for epoch in range(epochs):

    total_reward = 0

    total_policy_loss = 0

    total_value_loss = 0

    for batch_states, batch_actions in data_loader:

        # Moving tensors to GPU
        batch_states = batch_states.to(device)

        batch_actions = batch_actions.to(device)

        # POLICY FORWARD PASS


        action_probabilities = policy_model(batch_states)

        distribution = torch.distributions.Categorical(
            action_probabilities
        )

        sampled_actions = distribution.sample()

        # COMPUTING REWARDS


        rewards = []

        for predicted, actual in zip(
            sampled_actions,
            batch_actions
        ):

            reward = reward_function(
                predicted.item(),
                actual.item()
            )

            rewards.append(reward)

        rewards = torch.FloatTensor(
            rewards
        ).to(device)

        # VALUE PREDICTIONS

        state_values = value_model(
            batch_states
        ).squeeze()

        # ADVANTAGE COMPUTATION

        advantages = rewards - state_values.detach()

        # POLICY LOSS

        log_probabilities = distribution.log_prob(
            sampled_actions
        )

        policy_loss = -(
            log_probabilities * advantages
        ).mean()

        # VALUE LOSS


        value_loss_function = nn.MSELoss()

        value_loss = value_loss_function(
            state_values,
            rewards
        )

        # POLICY NETWORK UPDATE

        policy_optimizer.zero_grad()

        policy_loss.backward()

        policy_optimizer.step()

        # VALUE NETWORK UPDATE
        # ====================================================

        value_optimizer.zero_grad()

        value_loss.backward()

        value_optimizer.step()

        # TRACKING METRICS

        total_reward += rewards.mean().item()

        total_policy_loss += policy_loss.item()

        total_value_loss += value_loss.item()

    # AVERAGE METRICS PER EPOCH
  

    average_reward = total_reward / len(data_loader)

    average_policy_loss = (
        total_policy_loss / len(data_loader)
    )

    average_value_loss = (
        total_value_loss / len(data_loader)
    )

    reward_history.append(average_reward)

    policy_loss_history.append(
        average_policy_loss
    )

    value_loss_history.append(
        average_value_loss
    )

    # PRINTING TRAINING PROGRESS


    print(
        f"Epoch {epoch+1} | "
        f"Reward : {average_reward:.4f} | "
        f"Policy Loss : {average_policy_loss:.4f} | "
        f"Value Loss : {average_value_loss:.4f}"
    )
# PLOTTING REWARD CURVE


plt.figure(figsize=(10,5))

plt.plot(reward_history)

plt.title("Reward Progression")

plt.xlabel("Epoch")

plt.ylabel("Average Reward")

plt.grid(True)

plt.show()


# PLOTTING POLICY LOSS


plt.figure(figsize=(10,5))

plt.plot(policy_loss_history)

plt.title("Policy Loss Progression")

plt.xlabel("Epoch")

plt.ylabel("Policy Loss")

plt.grid(True)

plt.show()

# ============================================================
# PLOTTING VALUE LOSS
# ============================================================

plt.figure(figsize=(10,5))

plt.plot(value_loss_history)

plt.title("Value Loss Progression")

plt.xlabel("Epoch")

plt.ylabel("Value Loss")

plt.grid(True)

plt.show()

# ============================================================
# MODEL EVALUATION
# ============================================================

test_input = torch.FloatTensor(
    np.random.rand(1, state_size)
).to(device)

predicted_probabilities = policy_model(
    test_input
)

predicted_action = torch.argmax(
    predicted_probabilities,
    dim=1
)

print("Predicted Action :", predicted_action.item())

# ============================================================
# SAVING TRAINED MODELS
# ============================================================

torch.save(
    policy_model.state_dict(),
    "policy_network.pth"
)

torch.save(
    value_model.state_dict(),
    "value_network.pth"
)

print("Models saved successfully.")

